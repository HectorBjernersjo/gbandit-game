FROM rust:1-bookworm

# sqlite3 is here so `docker compose exec backend sqlite3 /data/db.sqlite` gives
# you a shell on the dev database.
RUN apt-get update \
    && apt-get install -y curl sqlite3 \
    && rm -rf /var/lib/apt/lists/*

RUN cargo install cargo-watch --locked

WORKDIR /app

EXPOSE 8080

# The app applies its own migrations at boot, so there is nothing to run first.
CMD ["cargo", "watch", "-x", "run"]
