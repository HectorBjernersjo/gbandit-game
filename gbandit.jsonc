{
    "project": "replace-with-project",
    "frontend": {
        "dockerfile": "frontend/Dockerfile", "context": "frontend"
    },
    // Opt-in: uncomment `backend` to deploy the backend (see AGENTS.md).
    // Add `database` when the backend needs one — that also means uncommenting
    // the database wiring in backend/ (Cargo.toml, src/config.rs, src/lib.rs,
    // src/main.rs) and writing your first migration in backend/migrations/.
    // "backend": {
    //     "dockerfile": "backend/Dockerfile", "context": "backend"
    // },
    // "database": {
    //     "engine": "sqlite"
    // },
    "local_dev": {
        "auto_commit": true
    }
}
