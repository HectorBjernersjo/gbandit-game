{
    "project": "replace-with-project",
    "frontend": {
        "dockerfile": "frontend/Dockerfile", "context": "frontend"
    },
    // Opt-in: uncomment `backend` to deploy the backend (see AGENTS.md).
    // Add `database` when the backend needs one — also uncomment the DB
    // wiring in backend/ (Cargo.toml, src/lib.rs, src/main.rs, Dockerfile).
    // "backend": {
    //     "dockerfile": "backend/Dockerfile", "context": "backend"
    // },
    // "database": {
    //     "engine": "sqlite"
    // },
    // For sqlite the migrations ship inside the backend image (/app/migrations,
    // see backend/Dockerfile). Postgres instead declares where they live in the
    // repo: "engine": "postgres", "migrations": "backend/migrations".
    "local_dev": {
        "auto_commit": true
    }
}
